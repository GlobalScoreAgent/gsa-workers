# Copy to .env for local runs (never commit .env)
SUPABASE_DB_URL=postgresql://...
WORKER_ID=backfill-a
MAX_RUNTIME_SECONDS=19800

# Ethos history
ETHOS_CONCURRENCY=3
ETHOS_CLAIM_BATCH_SIZE=10
ETHOS_CLAIM_STALE_SECONDS=7200
# GOLDSKY_ETHOS_URL=

# Ethos scores
SCORE_BATCH_SIZE=50
SCORE_TTL_DAYS=15
SCORE_THROTTLE_MS=200
# ETHOS_API_BASE=https://api.ethos.network/api/v2

# ERC-8183 satellites
ERC8183_CLAIM_BATCH_SIZE=100
ERC8183_CLAIM_STALE_SECONDS=7200
ERC8183_CONCURRENCY=5
# GOLDSKY_ERC8183_URL=

# Virtual ACP satellites
VIRTUAL_ACP_CLAIM_BATCH_SIZE=100
VIRTUAL_ACP_CLAIM_STALE_SECONDS=7200
VIRTUAL_ACP_CONCURRENCY=5
# GOLDSKY_VIRTUAL_ACP_URL=
