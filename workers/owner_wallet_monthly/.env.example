# Copy to .env for local runs (never commit .env)
SUPABASE_DB_URL=postgresql://...
ALCHEMY_KEY=your_alchemy_key
MONTHLY_CONCURRENCY=15
MONTHLY_CLAIM_BATCH_SIZE=100
ORIGIN_CONCURRENCY=4
ORIGIN_CLAIM_BATCH_SIZE=50
ALCHEMY_MAX_INFLIGHT=8
CLAIM_STALE_SECONDS=7200
TRANSIENT_REQUEUE_SECONDS=3600
MAX_RUNTIME_SECONDS=19800
